{% comment %}
  Unified languages entry renderer for both formats
  - RenderCV uses: name, summary
  - JSONResume uses: language, fluency
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="skill-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      <strong>
        {{- entry.label -}}
        {%- if entry.level %} ({{ entry.level }}){% endif %}</strong
      >
      {% if entry.name %}
        {% for keyword in entry.name %}
          {% if forloop.last %}
            {{ keyword }}
          {% else %}
            {{ keyword }},
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
</div>




{% comment %} <style>
  .language-item {
    padding: 0.5rem 0;
  }
</style> {% endcomment %}
